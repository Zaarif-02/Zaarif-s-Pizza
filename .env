# WordPress REST API base URL — no trailing slash
#
# Local development (LocalWP):
VITE_WP_API_URL=http://cafe.local/wp-json/wp/v2
#
# Live site (InfinityFree) — uncomment and update when deploying:
# VITE_WP_API_URL=https://your-site.infinityfreeapp.com/wp-json/wp/v2

# Your Custom Post Type slug — must match what you registered in WordPress
VITE_CPT_SLUG=projectss